<Window x:Class="Hooking.ConfirmRemoveWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Remove profile"
        Width="420" Height="200"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Display">

    <!-- Stretched over the owner at run time, so a click anywhere outside the dialog
         lands here and dismisses it. Relying on the window losing focus was unreliable. -->
    <!-- The backdrop carries a rounded clip, applied in code.

         ClipToBounds would not do: it clips to an element's rectangular bounds and ignores
         CornerRadius, so the scrim's square corners showed past the frame of the window
         underneath. A RectangleGeometry with a radius is the only clip that follows the
         rounding, and it needs the window's size, which is why it is built in the code
         behind. -->
    <Border x:Name="RoundedRoot">
        <Grid x:Name="Backdrop" Background="Transparent" MouseLeftButtonDown="Backdrop_MouseDown">

        <!-- A plain dimming scrim, clipped to the window's own rounding so its corners
             cannot reach past the frame. -->
        <Border CornerRadius="{StaticResource WindowRadius}" ClipToBounds="True">
            <Rectangle Fill="#8C000000" />
        </Border>

        <Border x:Name="Dialog" Width="420" Height="200"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                CornerRadius="{StaticResource WindowRadius}"
                Background="{StaticResource WindowBrush}"
                BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="44" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                    <TextBlock Text="Remove" Style="{StaticResource TitleText}" Margin="18,0,0,0" />
                    <Button Style="{StaticResource CloseChromeButton}" HorizontalAlignment="Right"
                            Margin="0,0,8,0" Click="Cancel_Click" ToolTip="Cancel">
                        <Viewbox Width="16" Height="16">
                            <Canvas Width="16" Height="16">
                                <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Data="M4.5 4.5 L11.5 11.5 M11.5 4.5 L4.5 11.5" />
                            </Canvas>
                        </Viewbox>
                    </Button>
                </Grid>

                <TextBlock Grid.Row="1" x:Name="QuestionText" Style="{StaticResource BodyText}"
                           TextWrapping="Wrap" Margin="18,0,18,0" VerticalAlignment="Top" />

                <!-- Remove only. Cancelling is what the close cross and a click outside
                     already do, so a Cancel button would be a third way to say it. -->
                <Grid Grid.Row="2" Margin="18,0,18,16">
                    <Button Content="Remove" Style="{StaticResource PrimaryButton}"
                            HorizontalAlignment="Right" Click="Confirm_Click" />
                </Grid>
            </Grid>
        </Border>
        </Grid>
    </Border>
</Window>