<Window x:Class="SnapHook.RenameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rename"
        Width="440" Height="270"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Display">

    <!-- The window is stretched over its owner at run time, so this root covers the
         whole application. Anything the user clicks that is not the dialog lands
         here, which is what lets a click outside dismiss it: relying on the window
         losing focus was unreliable, because clicking the owner did not always
         deactivate this one. -->
    <!-- The backdrop carries a rounded clip, applied in code.

         ClipToBounds would not do: it clips to an element's rectangular bounds and ignores
         CornerRadius, so the scrim's square corners showed past the frame of the window
         underneath. A RectangleGeometry with a radius is the only clip that follows the
         rounding, and it needs the window's size, which is why it is built in the code
         behind. -->
    <Border x:Name="RoundedRoot">
        <Grid x:Name="Backdrop" Background="Transparent" MouseLeftButtonDown="Backdrop_MouseDown">

        <!-- A plain dimming scrim, clipped to the window's own rounding.

             The blur is gone. It was attempted several ways — a captured frame, a live
             effect on the owner, a downscaled capture stretched back up — and each of
             them produced an artefact: a border of desktop, a duplicated interface, or a
             rectangle reaching past the frame. Dimming cannot go wrong: it is a filled
             rectangle inside a window that is exactly the size of the owner. -->
        <Border CornerRadius="{StaticResource WindowRadius}" ClipToBounds="True">
            <Rectangle Fill="#B3000000" />
        </Border>

        <!-- The dialog. Clicks inside it are handled by its own controls and never
             reach the backdrop. -->
        <Border x:Name="Dialog" Width="440" Height="270"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                CornerRadius="{StaticResource WindowRadius}"
                Background="{StaticResource WindowBrush}"
                BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="44" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                    <TextBlock Text="Profile name" Style="{StaticResource TitleText}" Margin="16,0,0,0" />
                    <Button Style="{StaticResource CloseChromeButton}" HorizontalAlignment="Right"
                            Margin="0,0,8,0" Click="Cancel_Click">
                        <Viewbox Width="16" Height="16">
                            <Canvas Width="16" Height="16">
                                <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Data="M4.5 4.5 L11.5 11.5 M11.5 4.5 L4.5 11.5" />
                            </Canvas>
                        </Viewbox>
                    </Button>
                </Grid>

                <StackPanel Grid.Row="1" Margin="16,2,16,0">
                    <TextBox x:Name="ValueBox" Style="{StaticResource FieldBox}"
                             Height="34" Padding="10,0" KeyDown="ValueBox_KeyDown" />

                    <!-- Room between the label and its field, and a Browse beside the field
                         so the path can be changed without touching the name. -->
                    <TextBlock Text="Path" Style="{StaticResource FieldLabel}" Margin="0,18,0,8" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="PathBox" Style="{StaticResource FieldBox}"
                                 Height="34" Padding="10,0" />

                        <Button Grid.Column="1" Content="Browse"
                                Style="{StaticResource SecondaryButton}"
                                Height="34" Width="96" Margin="8,0,0,0"
                                Click="Browse_Click" />
                    </Grid>
                </StackPanel>

                <!-- Save only. Cancelling is what the close cross and a click outside
                     already do, so a second button for it was clutter. -->
                <Grid Grid.Row="2" Margin="16,0,16,16">
                    <Button Content="Save" Style="{StaticResource PrimaryButton}"
                            HorizontalAlignment="Right" Click="Save_Click" />
                </Grid>
            </Grid>
        </Border>
        </Grid>
    </Border>
</Window>
