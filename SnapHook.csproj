<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>SnapHook</AssemblyName>
    <RootNamespace>SnapHook</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\SnapHook.ico</ApplicationIcon>
    <RebuildNativeWorker Condition="'$(RebuildNativeWorker)' == ''">false</RebuildNativeWorker>
  </PropertyGroup>

  <ItemGroup>
    <!-- The native engine is a program file, not per-user runtime data. The Link
         puts it beside SnapHook.exe both in bin and in the publish directory. -->
    <Content Include="Native\SnapHookWorker.exe">
      <Link>SnapHookWorker.exe</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <!-- Main application icon plus compact, state-specific tray icons. -->
    <Resource Include="Assets\SnapHook.png" />
    <Resource Include="Assets\TrayEnabled.png" />
    <Resource Include="Assets\TrayDisabled.png" />
    <Resource Include="Assets\SnapHook.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- Taskbar notification area (tray) icon with its context menu. -->
    <PackageReference Include="Hardcodet.NotifyIcon.Wpf" Version="2.0.1" />
  </ItemGroup>

  <!-- Inputs/Outputs makes MSBuild recompile the engine only when its source is
       newer than the binary (or the binary is missing), and skip it otherwise.
       Without this the embedded worker would quietly go stale after an edit.
       Force a rebuild with -p:RebuildNativeWorker=true. -->
  <Target Name="BuildSnapHookWorker" BeforeTargets="BeforeBuild"
          Inputs="$(MSBuildProjectDirectory)\Native\SnapHookWorker.cpp"
          Outputs="$(MSBuildProjectDirectory)\Native\SnapHookWorker.exe"
          Condition="'$(RebuildNativeWorker)' != 'true'">
    <Exec Command="&quot;$(MSBuildProjectDirectory)\Native\build-worker.cmd&quot; &quot;$(MSBuildProjectDirectory)\Native&quot; &quot;$(MSBuildProjectDirectory)\Native&quot;" />
  </Target>

  <Target Name="ForceRebuildSnapHookWorker" BeforeTargets="BeforeBuild"
          Condition="'$(RebuildNativeWorker)' == 'true'">
    <Exec Command="&quot;$(MSBuildProjectDirectory)\Native\build-worker.cmd&quot; &quot;$(MSBuildProjectDirectory)\Native&quot; &quot;$(MSBuildProjectDirectory)\Native&quot;" />
  </Target>

</Project>
